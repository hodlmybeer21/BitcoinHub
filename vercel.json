{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "crons": [
    {
      "path": "/api/cron/refresh-btc-history",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/persistence/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/dca-simulator",
      "destination": "/api/dca-simulator"
    },
    {
      "source": "/api/dca-simulator/",
      "destination": "/api/dca-simulator"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/slides/(.*)",
      "destination": "/slides/$1"
    },
    {
      "source": "/cycle/compare",
      "destination": "/index.html"
    },
    {
      "source": "/cycle/compare/",
      "destination": "/index.html"
    },
    {
      "source": "/cycle/(.*)",
      "destination": "/cycle/$1"
    },
    {
      "source": "/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/favicon-16x16.png",
      "destination": "/favicon-16x16.png"
    },
    {
      "source": "/favicon-32x32.png",
      "destination": "/favicon-32x32.png"
    },
    {
      "source": "/favicon-48x48.png",
      "destination": "/favicon-48x48.png"
    },
    {
      "source": "/icon-192.png",
      "destination": "/icon-192.png"
    },
    {
      "source": "/icon-512.png",
      "destination": "/icon-512.png"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/og-image.png",
      "destination": "/og-image.png"
    },
    {
      "source": "/twitter-image.png",
      "destination": "/twitter-image.png"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}