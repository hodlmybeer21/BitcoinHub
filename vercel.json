{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "crons": [
    {
      "path": "/api/cron/refresh-btc-history",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/persistence/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/dca-simulator",
      "dest": "/api/dca-simulator"
    },
    {
      "src": "/api/dca-simulator/",
      "dest": "/api/dca-simulator"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/slides/(.*)",
      "dest": "/slides/$1"
    },
    {
      "src": "/cycle/(.*)",
      "dest": "/cycle/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}