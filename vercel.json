{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "routes": [
    {
      "src": "/api/dca-simulator",
      "dest": "/api/dca-simulator"
    },
    {
      "src": "/api/dca-simulator/",
      "dest": "/api/dca-simulator"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/slides/(.*)",
      "dest": "/slides/$1"
    },
    {
      "src": "/cycle/(.*)",
      "dest": "/cycle/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}