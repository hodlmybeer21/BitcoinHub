{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "crons": [
    {
      "path": "/api/cron/refresh-btc-history",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/dca-simulator",
      "dest": "/api/dca-simulator"
    },
    {
      "src": "/api/dca-simulator/",
      "dest": "/api/dca-simulator"
    },
    {
      "src": "/api/mpt",
      "dest": "/api/mpt"
    },
    {
      "src": "/api/mpt/",
      "dest": "/api/mpt"
    },
    {
      "src": "/api/workbench",
      "dest": "/api/workbench"
    },
    {
      "src": "/api/workbench/",
      "dest": "/api/workbench"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/slides/(.*)",
      "dest": "/slides/$1"
    },
    {
      "src": "/cycle/(.*)",
      "dest": "/cycle/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}