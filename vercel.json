{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "crons": [
    {
      "path": "/api/cron/refresh-btc-history",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/dca-simulator",
      "dest": "/api/dca-simulator"
    },
    {
      "src": "/api/dca-simulator/",
      "dest": "/api/dca-simulator"
    },
    {
      "src": "/api/mpt/cycles",
      "dest": "/api/mpt-cycles"
    },
    {
      "src": "/api/mpt/cycles/",
      "dest": "/api/mpt-cycles"
    },
    {
      "src": "/api/mpt/compute",
      "dest": "/api/mpt-compute"
    },
    {
      "src": "/api/mpt/compute/",
      "dest": "/api/mpt-compute"
    },
    {
      "src": "/api/mpt/quote",
      "dest": "/api/mpt-quote"
    },
    {
      "src": "/api/mpt/quote/",
      "dest": "/api/mpt-quote"
    },
    {
      "src": "/api/workbench/blocks",
      "dest": "/api/workbench-blocks"
    },
    {
      "src": "/api/workbench/blocks/",
      "dest": "/api/workbench-blocks"
    },
    {
      "src": "/api/workbench/templates",
      "dest": "/api/workbench-templates"
    },
    {
      "src": "/api/workbench/templates/",
      "dest": "/api/workbench-templates"
    },
    {
      "src": "/api/workbench/parse",
      "dest": "/api/workbench-parse"
    },
    {
      "src": "/api/workbench/parse/",
      "dest": "/api/workbench-parse"
    },
    {
      "src": "/api/workbench/evaluate",
      "dest": "/api/workbench-evaluate"
    },
    {
      "src": "/api/workbench/evaluate/",
      "dest": "/api/workbench-evaluate"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/slides/(.*)",
      "dest": "/slides/$1"
    },
    {
      "src": "/cycle/(.*)",
      "dest": "/cycle/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}