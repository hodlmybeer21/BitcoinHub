# ─── Vercel deploy exclusions ──────────────────────────────────────────────
# Prevents the 15,000-file upload limit (we hit 20,676 without this).
# node_modules alone is ~15-20k files; .git is another ~2k.

# Dependencies
node_modules/
**/node_modules/
.pnp/
.pnp.js

# Build output (regenerated during build)
dist/
build/
.next/
.turbo/
.cache/

# Version control
.git/
.gitignore
.gitattributes

# Test/coverage
coverage/
*.test.ts
*.test.tsx
*.test.js
*.spec.ts
**/__tests__/
**/__mocks__/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Env files (NEVER deploy secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Workspace clutter
.clawhub/
.quarantine/
.openclaw/
_memory_archive/
static/slides/
static/images/

# Memory/scratch files
DREAMS.md
HEARTBEAT.md
*.bak

# TypeScript build cache
*.tsbuildinfo
.tsbuildinfo

# Vercel internals
.vercel/

# PowerPoint files (regenerated from sources)
*.pptx
